# Copy to .env.local for development.

# Strapi's public URL: images and form posts from the browser use it.
# Inlined into the browser bundle at build time, so rebuild after changing it.
VITE_STRAPI_URL=http://localhost:1337

# Optional: how the server reaches Strapi. In production on Dokploy, Strapi's
# internal address on the Docker network. Defaults to VITE_STRAPI_URL.
STRAPI_URL=
