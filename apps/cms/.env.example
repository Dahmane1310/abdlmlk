HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Production behind a reverse proxy (Traefik in Dokploy): the CMS's public
# https address, and the header holding the visitor's IP (behind Cloudflare,
# CF-Connecting-IP; the spam limits and likes count per visitor).
PUBLIC_URL=
IS_PROXIED=false
PROXY_IP_HEADER=X-Forwarded-For

# Production database: PostgreSQL. Left commented out (not empty), the CMS
# uses SQLite in .tmp/data.db.
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://strapi:password@host:5432/strapi

# Public URL of the website: newsletter links and redirects, and the only
# origin allowed to call the public endpoints from a browser (CORS)
SITE_URL=http://localhost:3000
# Receives contact messages and new-comment notifications
OWNER_EMAIL=

# SMTP for emails. Leave SMTP_HOST empty to skip sending (links are logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Cloudflare Turnstile captcha on comments, newsletter and contact
TURNSTILE_SECRET_KEY=
