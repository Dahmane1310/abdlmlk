{
  "kind": "singleType",
  "collectionName": "profiles",
  "info": {
    "singularName": "profile",
    "pluralName": "profiles",
    "displayName": "Profile",
    "description": "Who you are: the hero, about section and contact details"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "headline": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "intro": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "bio": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "location": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "email": {
      "type": "email",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "availability": {
      "type": "enumeration",
      "enum": [
        "open_to_both",
        "open_to_work",
        "open_to_freelance",
        "not_available"
      ],
      "default": "open_to_both",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "availabilityNote": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "resume": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "highlights": {
      "type": "component",
      "component": "shared.metric",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "socials": {
      "type": "component",
      "component": "shared.social-link",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "spokenLanguages": {
      "type": "component",
      "component": "shared.spoken-language",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
