      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "language",
        "frontend",
        "backend",
        "database",
        "devops",
        "tool",
        "ai",
        "mobile"
      ],
      "required": true
    },
    "icon": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
